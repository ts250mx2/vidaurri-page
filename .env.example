# Plantilla de variables de entorno de Vidaurri Page.
# Copia este archivo a .env y llena los valores reales.

# MySQL (bdav) — catálogo de piezas nuevas. USAR UN USUARIO DE SOLO LECTURA.
MYSQL_SERVER_USER=
MYSQL_SERVER_PASSWORD=
MYSQL_SERVER_SERVER=
MYSQL_SERVER_DATABASE=bdav

# MySQL Bodega Usado — piezas usadas (solo lectura).
MYSQL_USADAS_SERVER=
MYSQL_USADAS_PORT=3306
MYSQL_USADAS_USER=
MYSQL_USADAS_PASSWORD=
MYSQL_USADAS_DATABASE=wwapvi_bd-usadas

# Webservice del Vendedor IA (vidaurri-ia) y su API key.
VENDEDOR_IA_URL=http://localhost:3038
WHATSAPP_API_KEY=

# URL pública del sitio (metadatos, sitemap, JSON-LD).
SITE_URL=http://localhost:3041
