# Plantilla de variables de entorno de Vidaurri Page.
# Copia este archivo a .env y llena los valores reales.

# MySQL (bdav) — catálogo de piezas nuevas. USAR UN USUARIO DE SOLO LECTURA.
MYSQL_SERVER_USER=
MYSQL_SERVER_PASSWORD=
MYSQL_SERVER_SERVER=
MYSQL_SERVER_DATABASE=bdav

# MySQL Bodega Usado — piezas usadas (solo lectura).
MYSQL_USADAS_SERVER=
MYSQL_USADAS_PORT=3306
MYSQL_USADAS_USER=
MYSQL_USADAS_PASSWORD=
MYSQL_USADAS_DATABASE=wwapvi_bd-usadas

# Webservice del Vendedor IA (vidaurri-ia) y su API key.
VENDEDOR_IA_URL=http://localhost:3038
WHATSAPP_API_KEY=

# URL pública del sitio (metadatos, sitemap, JSON-LD).
SITE_URL=http://localhost:3041

# Mostrador (/mostrador, pedidos del vendedor). Ambas viven también en vidaurri-ia.
# MOSTRADOR_API_KEY: key servidor→servidor para /api/mostrador/* de vidaurri-ia
# (distinta de WHATSAPP_API_KEY). MOSTRADOR_JWT_SECRET: MISMO valor en los dos
# repos; con él vidaurri-page verifica localmente el token de sesión del vendedor.
MOSTRADOR_API_KEY=
MOSTRADOR_JWT_SECRET=

# Proxy inverso de confianza enfrente de vidaurri-page (nginx, Cloudflare…).
# CONFIAR_XFF=1 hace que la IP del vendedor para el rate limit del login del
# mostrador se tome del ÚLTIMO salto de x-forwarded-for (el que anexa ese
# proxy). Sin proxy déjalo vacío: ese header lo puede inventar el navegador y
# es mejor no mandar IP (IA limita solo por usuario).
CONFIAR_XFF=
